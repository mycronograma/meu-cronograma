{
  "name": "nexora",
  "version": "1.0.0",
  "description": "AI-powered study optimization platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "local:setup": "powershell -ExecutionPolicy Bypass -File scripts/local-setup.ps1",
    "local:dev": "powershell -ExecutionPolicy Bypass -File scripts/local-dev.ps1",
    "local:db:up": "docker compose -f docker-compose.local.yml up -d",
    "local:db:down": "docker compose -f docker-compose.local.yml down",
    "vercel-build": "node scripts/vercel-build.cjs",
    "test:roadmap": "tsx scripts/roadmap.test.ts",
    "test:student-audit": "tsx scripts/student-product-audit.test.ts",
    "test:smoke:presets": "tsx scripts/smoke-presets.ts",
    "test:backlog": "tsx scripts/backlog-rescheduler.test.ts",
    "test:gamification": "tsx scripts/gamification.test.ts",
    "test:year-simulation": "tsx scripts/year-simulation.test.ts",
    "test:trainer-dashboard": "playwright test scripts/trainer-dashboard-audit.spec.cjs --reporter=line"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.7.1",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.303.0",
    "next": "^15.5.16",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "tailwind-merge": "^2.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.16",
    "postcss": "^8.4.33",
    "prisma": "^5.7.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
